      "name": "[guid(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('mi-aks-kubelet-{0}', parameters('environmentName'))), 'acrpull')]",
