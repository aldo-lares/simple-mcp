        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('mi-aks-{0}', parameters('environmentName')))]",
        "[extensionResourceId(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('mi-aks-kubelet-{0}', parameters('environmentName'))), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('mi-aks-kubelet-{0}', parameters('environmentName'))), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('mi-aks-{0}', parameters('environmentName'))), 'mio'))]",
